#include <tunables/global>

# The task runner is an unprivileged, capability-free, read-only Docker workload. This parent
# profile only permits transition into the packaged bubblewrap profile used by Codex and the
# repository's allowlisted preparation/verification commands.
profile sowhat-task-runner flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  allow capability,
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow dbus,

  allow file rwlkm /{**,},
  allow px /usr/bin/bwrap -> bwrap,
  allow ix /{app,bin,etc,home,lib,lib64,opt,root,run,sbin,srv,state,tmp,usr,var}/**,
}
